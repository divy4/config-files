#!/usr/bin/env bash
set -euo pipefail

function is_fullscreen {
  local windows
  windows="$(swaymsg -t get_tree \
  | jq --raw-output '
    def is_fullscreen(x):
      x.type == "con" and x.app_id != null and x.fullscreen_mode != 0
      ;
    def get_fullscreen_windows(x):
      if is_fullscreen(x)
      then [x.app_id]
      else []
      end as $nodes
      | [$nodes, [x.nodes[] | get_fullscreen_windows(.)]] | flatten
      ;
    get_fullscreen_windows(.) | join("\n")
  ')"
  if [[ -z "$windows" ]]; then
    return 1
  fi
  echo "Fullscreen windows found: $windows"
}

function is_playing_audio {
  if ! pacmd list-sink-inputs \
  | grep --quiet --fixed-strings 'state: RUNNING'; then
    return 1
  fi
  echo "Audio is playing"
}

if is_fullscreen || is_playing_audio; then
  case "$(( RANDOM % 4 ))" in
    0)
      swaymsg 'seat - cursor move 1 0';;
    1)
      swaymsg 'seat - cursor move -1 0';;
    2)
      swaymsg 'seat - cursor move 0 1';;
    3)
      swaymsg 'seat - cursor move 0 -1';;
  esac
fi

